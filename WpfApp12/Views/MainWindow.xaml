<Window x:Class="WpfApp12.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp12.Views"
        Title="LibraryManager — учёт книг" Height="500" Width="820"
        MinHeight="350" MinWidth="700" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BookStatusConverter x:Key="StatusConverter" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Image Source="/Resources/Logo.png" Height="40" Margin="0,0,10,0" />
            <TextBlock Text="Каталог книг" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Сбросить" Margin="8,0,0,0"
                    Command="{Binding ResetSearchCommand}" />
            <Button DockPanel.Dock="Right" Content="Найти" Margin="8,0,0,0"
                    Command="{Binding SearchCommand}" />
            <TextBox VerticalContentAlignment="Center" Padding="4"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" />
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="200" />
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="70" />
                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status, Converter={StaticResource StatusConverter}}"
                                    Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Добавить" Command="{Binding AddCommand}" />
            <Button Content="Изменить" Command="{Binding EditCommand}" />
            <Button Content="Удалить" Command="{Binding DeleteCommand}" />
            <Button Content="Выдать" Command="{Binding IssueCommand}" Margin="24,0,8,0" />
            <Button Content="Вернуть" Command="{Binding ReturnCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,10,0,0" Foreground="Gray"
                   Text="{Binding StatusMessage}" />
    </Grid>
</Window>
